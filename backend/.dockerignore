# --- 秘密情報・環境変数 ---
# .env は必ずイメージに含めない（コンテナ実行時に環境変数で注入）
.env
.env.*
!.env.example

# --- Python バイトコード / キャッシュ ---
__pycache__/
*.py[cod]
*.pyo
*.pyd

# --- 仮想環境 ---
venv/
.venv/
env/

# --- テスト / Lint キャッシュ ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- テスト・ドキュメント（実行時に不要） ---
tests/
docs/

# --- IDE / OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db

# --- Git / CI ---
.git/
.gitignore
.github/

# --- Docker 関連メタ ---
Dockerfile
.dockerignore

# --- デプロイツール設定（コンテナ内では不要） ---
fly.toml
