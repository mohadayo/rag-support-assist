# ============================================================
# 必須の環境変数
# ============================================================

# OpenAI API キー (Embedding と回答生成に利用)
OPENAI_API_KEY=sk-your-api-key-here

# PostgreSQL (pgvector) への接続 URL
DATABASE_URL=postgres://user:password@localhost:5432/rag_support?sslmode=disable

# ============================================================
# 任意の環境変数 (省略時はコード側のデフォルトが適用されます)
# ============================================================

# CORS を許可するオリジン (カンマ区切りで複数指定可)
# デフォルト: http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# 回答生成 / エスカレーション判定に利用する OpenAI Chat モデル名
# デフォルト: gpt-4o-mini
# 例: gpt-4o, gpt-4o-mini, gpt-4.1-mini など
RAG_MODEL=gpt-4o-mini

# 文書アップロード時のファイルサイズ上限 (MB, 正の整数)
# デフォルト: 10
# 不正値 (負・0・非数値) を指定した場合はデフォルト値にフォールバックします
MAX_UPLOAD_SIZE_MB=10

# 問い合わせ時のベクトル検索で取得する上位件数 (正の整数)
# デフォルト: 5
# 不正値 (負・0・非数値) を指定した場合はデフォルト値にフォールバックします
QUERY_TOP_K=5
